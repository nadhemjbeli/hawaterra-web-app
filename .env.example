NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Farm location used by the external weather section
HAWATERRA_FARM_NAME=Experimental Farm
HAWATERRA_FARM_LATITUDE=00.0000
HAWATERRA_FARM_LONGITUDE=00.0000
